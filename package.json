{
  "name": "llm-npc-engine",
  "version": "0.0.0",
  "private": true,
  "description": "A data-driven engine for NPCs that talk through an LLM while the game's progression stays decided in code.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "play": "node --env-file-if-exists=.env src/cli/play.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.11.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
