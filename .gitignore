**/passcode*
books/
manuscript/

# シナリオ実データ（公開するのは雛形のみ。本編シナリオは別管理）
scenarios/private/
*.private.json

# モデル本体（数GB。配布しない）
*.gguf
*.safetensors
models/

# 一般
node_modules/
dist/
.DS_Store
*.log
