# Which backend the engine talks to. Changing this line is the whole switch —
# no code above src/llm/ knows the difference.
#
# Model names age out fast, so they live here rather than in the source.
# Copy this file to .env and edit. Never commit .env (see .gitignore).

LLM_BACKEND=ollama

# --- ollama: runs on your own machine, no key, no cost ----------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_k_m

# --- any OpenAI-compatible provider -----------------------------------------
# Several inexpensive providers speak this exact shape, so moving between them
# is a base URL and a model name.
# OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# --- Claude ------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
